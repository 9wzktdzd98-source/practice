# Port the API server runs on
PORT=4000

# Public URL where this app will be reachable once deployed
# (used to generate the LTI launch URL and config XML)
PUBLIC_URL=http://localhost:4000

# URL the frontend quiz lives at (usually same as PUBLIC_URL for this starter)
FRONTEND_URL=http://localhost:4000

# Secret used to sign short-lived app session tokens issued after an LTI launch.
# Generate a real one before deploying: `openssl rand -hex 32`
APP_JWT_SECRET=change-me-before-deploying

# --- LTI credentials (fill in once you register this tool with a school's LMS) ---
# LTI 1.1
LTI_CONSUMER_KEY=
LTI_CONSUMER_SECRET=

# LTI 1.3 (if you swap in the ltijs library — see src/routes/lti.js)
LTI_PLATFORM_CLIENT_ID=
LTI_PLATFORM_ISSUER=
LTI_PLATFORM_AUTH_URL=
LTI_PLATFORM_TOKEN_URL=
LTI_PLATFORM_JWKS_URL=
